# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND FRUVER POS MANAGER
# ==============================================================================

# --- MODO 1: EJECUCIÓN LOCAL (PREDETERMINADO RECOMENDADO) ---
# En desarrollo local con Vite o al servir desde el backend en localhost:
# Usar /api permite que el proxy de Vite o FastAPI manejen las peticiones sin problemas de CORS ni latencia.
VITE_API_BASE_URL=/api
VITE_API_URL=http://localhost:8000

# Si deseas forzar que localhost se conecte al backend de la nube en vez del backend local, descomenta:
# VITE_FORCE_REMOTE_API=true

# --- MODO 2: DESPLIEGUE EN LA NUBE (RENDER / VERCEL / PRODUCCIÓN) ---
# Descomenta y ajusta las URLs de tu servicio en la nube:
# VITE_API_BASE_URL=https://backend-inventario-1-xx1v.onrender.com/api
# VITE_API_BASE_URL2=https://backend-inventario-4ynw.onrender.com/api
# VITE_API_URL=https://backend-inventario-1-xx1v.onrender.com
# VITE_API_URL2=https://backend-inventario-4ynw.onrender.com

# --- PARÁMETROS COMERCIALES Y GENERALES ---
PORT=8004
VITE_APP_TITLE="Fruver POS Manager"
VITE_DEFAULT_PROFIT_MARGIN=30
VITE_ROUNDING_BASE=100
VITE_AUTO_SEARCH_DELAY_MS=400
VITE_MAX_FILE_SIZE_MB=15
